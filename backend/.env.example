# Copy to .env and adjust as needed
CORS_ORIGINS=http://localhost:3000

# --- RAG / Onboarding ---
# Local Qdrant file-backed storage path (relative to the working directory)
QDRANT_PATH=./qdrant_storage

# fastembed model name (BAAI/bge-small-en-v1.5 is ~130 MB, 384-dim)
EMBED_MODEL=BAAI/bge-small-en-v1.5

# Ollama endpoint and model for /api/onboarding/chat answer generation
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3
